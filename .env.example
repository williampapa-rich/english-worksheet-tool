# ─── 데이터베이스 ────────────────────────────────────────────────────────────
# 형식: postgresql+asyncpg://user:password@host:port/dbname
# 로컬 직접 실행 시 (uv run uvicorn ...):
DATABASE_URL=postgresql+asyncpg://worksheet:worksheet@localhost:5432/worksheet_db

# Docker Compose용 PostgreSQL 인증 정보
POSTGRES_USER=worksheet
POSTGRES_PASSWORD=worksheet           # 실제 배포 시 반드시 강력한 값으로 교체
POSTGRES_DB=worksheet_db

# ─── LLM ────────────────────────────────────────────────────────────────────
# Anthropic Claude API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# ─── 애플리케이션 ────────────────────────────────────────────────────────────
# 환경: development | staging | production
APP_ENV=development

# SQL 디버그 로그 출력 여부
DEBUG=false

# Phase 4 이전까지는 단일 테넌트 stub — 환경변수로 테넌트 ID 고정
MVP_TENANT_ID=00000000-0000-0000-0000-000000000001

# ─── 보안 ────────────────────────────────────────────────────────────────────
# JWT 시크릿 (Phase 4 OAuth 도입 전까지는 stub)
SECRET_KEY=change-me-in-production

# ─── 데이터베이스 ────────────────────────────────────────────────────────────
# 형식: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/english_worksheet

# ─── LLM ────────────────────────────────────────────────────────────────────
# Anthropic Claude API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# ─── 애플리케이션 ────────────────────────────────────────────────────────────
# 환경: development | staging | production
APP_ENV=development

# Phase 4 이전까지는 단일 테넌트 stub — 환경변수로 테넌트 ID 고정
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# ─── 보안 ────────────────────────────────────────────────────────────────────
# JWT 시크릿 (Phase 4 OAuth 도입 전까지는 stub)
SECRET_KEY=change-me-in-production

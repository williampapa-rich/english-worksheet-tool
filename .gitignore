# ─── Python ────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
.eggs/
*.so

# mypy 캐시
.mypy_cache/
.dmypy.json

# ruff 캐시
.ruff_cache/

# pytest 캐시
.pytest_cache/
.coverage
htmlcov/

# ─── Node.js ────────────────────────────────────────────────────────────────
node_modules/
dist/
.next/
out/
.vite/
*.tsbuildinfo

# pnpm
.pnpm-store/

# Playwright (apps/web/.gitignore 가 더 좁게 잡지만 root 레벨 안전망)
test-results/
playwright-report/
playwright/.cache/

# ─── 환경변수 / 시크릿 ──────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key

# ─── OS / IDE ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ─── Claude Code ────────────────────────────────────────────────────────────
.claude/worktrees/

# ─── 작업용 자료 (분석 입력, 산출물은 docs/에) ──────────────────────────────
admin/reference-analysis/frames/
admin/reference-analysis/source-videos/

# ─── Extractor fixture 자료 (저작권 이슈 — 아잉카 / 학교 내신 등) ────────────
# 자료 자체는 무시하지만 디렉토리 구조 (.gitkeep) 와 README 는 추적
admin/fixtures/extractor/**/*
!admin/fixtures/extractor/**/
!admin/fixtures/extractor/README.md
!admin/fixtures/extractor/**/README.md
!admin/fixtures/extractor/**/.gitkeep

# ─── 기타 ───────────────────────────────────────────────────────────────────
*.log
*.tmp

# ─── LLM 사용량 로그 — request_id / 토큰 / 시간 등 민감 메타 ────────────────
var/llm_usage.jsonl
var/llm_usage*.jsonl

# ─── 검수 산출물 — 와이프 브랜딩 정보 + 바이너리 history 누적 방지 ──────────
# B5 / 후속 검수 시점에 매번 재생성되는 ephemeral artifact 라 git 추적 불필요.
var/*.html
var/*.pdf
